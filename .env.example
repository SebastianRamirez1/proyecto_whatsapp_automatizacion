# ─── Base de datos ────────────────────────────────────────────────────────────
# Local (Docker):
DATABASE_URL=postgresql://postgres:postgres@db:5432/whatsapp_orders
# Railway (reemplazar con la URL que Railway provee automáticamente):
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# ─── WhatsApp / Meta ──────────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_para_verificacion
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
META_APP_SECRET=mi_app_secret_de_meta

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura_de_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generar hash con: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('tu_password'))"
ADMIN_PASSWORD_HASH=$2b$12$EixZaYVK1fsbw1ZfbX3OXePaWxn96p36WQoeG6Lruj3vjPGga31lW

# ─── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
